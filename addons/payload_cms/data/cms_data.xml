<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Allowed origins for the REST API (comma separated, '*' = any origin without credentials) -->
        <record id="config_cors" model="ir.config_parameter">
            <field name="key">payload_cms.cors</field>
            <field name="value">*</field>
        </record>
        <record id="config_token_expiration" model="ir.config_parameter">
            <field name="key">payload_cms.token_expiration</field>
            <field name="value">7200</field>
        </record>
        <!-- Default collections & globals (website template) -->
        <function model="cms.collection" name="_install_default_schema"/>
    </data>
</odoo>
