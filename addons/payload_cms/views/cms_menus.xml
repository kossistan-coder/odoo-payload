<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        payload_cms is a building block: it defines no menu of its own.
        The modules that depend on it add the menus they need, using these actions
        (see techlives_series/views/menus.xml).
    -->

    <!-- Payload admin embedded in the Odoo web client (navbar / apps menu stay visible) -->
    <record id="action_payload_admin" model="ir.actions.client">
        <field name="name">Payload CMS</field>
        <field name="tag">payload_cms.admin</field>
    </record>

    <!-- Configuration pages rendered with the Payload UI -->
    <record id="action_payload_config_collections" model="ir.actions.client">
        <field name="name">Collections</field>
        <field name="tag">payload_cms.admin</field>
        <field name="params" eval="{'path': '/config/collections'}"/>
    </record>
    <record id="action_payload_config_globals" model="ir.actions.client">
        <field name="name">Globals</field>
        <field name="tag">payload_cms.admin</field>
        <field name="params" eval="{'path': '/config/globals'}"/>
    </record>
    <record id="action_payload_config_blocks" model="ir.actions.client">
        <field name="name">Blocks</field>
        <field name="tag">payload_cms.admin</field>
        <field name="params" eval="{'path': '/config/blocks'}"/>
    </record>
    <record id="action_payload_config_fields" model="ir.actions.client">
        <field name="name">Fields</field>
        <field name="tag">payload_cms.admin</field>
        <field name="params" eval="{'path': '/config/fields'}"/>
    </record>
    <record id="action_payload_config_localization" model="ir.actions.client">
        <field name="name">Localization</field>
        <field name="tag">payload_cms.admin</field>
        <field name="params" eval="{'path': '/config/localization'}"/>
    </record>
    <record id="action_payload_config_multitenancy" model="ir.actions.client">
        <field name="name">Multisite</field>
        <field name="tag">payload_cms.admin</field>
        <field name="params" eval="{'path': '/config/multitenancy'}"/>
    </record>
    <record id="action_payload_config_storage" model="ir.actions.client">
        <field name="name">Storage</field>
        <field name="tag">payload_cms.admin</field>
        <field name="params" eval="{'path': '/config/storage'}"/>
    </record>
    <record id="action_payload_config_api_docs" model="ir.actions.client">
        <field name="name">API Docs</field>
        <field name="tag">payload_cms.admin</field>
        <field name="params" eval="{'path': '/api-docs'}"/>
    </record>
</odoo>
