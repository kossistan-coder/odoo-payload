<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="payload.DashboardView">
        <div class="gutter gutter--left gutter--right dashboard">
            <div>
                <div>
                    <div class="modular-dashboard" style="display: flex; flex-wrap: wrap">
                        <div class="widget" data-slug="collections-0" data-width="full" style="width: 100%; padding: 6px; opacity: 1; position: relative">
                            <div class="draggable" id="collections-0" style="width: 100%; height: 100%">
                                <div class="widget-wrapper">
                                    <div aria-hidden="false" class="widget-content">
                                        <div class="collections">
                                            <div class="collections__wrap">
                                                <t t-foreach="groups" t-as="group" t-key="group.label">
                                                    <div class="collections__group">
                                                        <h2 class="collections__label" t-esc="group.label"/>
                                                        <ul class="collections__card-list">
                                                            <t t-foreach="group.entities" t-as="entity" t-key="entity.href">
                                                                <li>
                                                                    <div t-att-class="'card card-' + entity.slug + ' card--has-onclick'" t-att-id="'card-' + entity.slug">
                                                                        <h3 class="card__title" t-esc="entity.label"/>
                                                                        <div t-if="entity.type === 'collection' and !entity.noCreate" class="card__actions">
                                                                            <a t-att-aria-label="t('general:createNewLabel', {label: entity.singular})" t-att-title="t('general:createNewLabel', {label: entity.singular})"
                                                                               t-att-href="entity.href + '/create'"
                                                                               class="btn btn--icon btn--icon-style-with-border btn--icon-only btn--size-medium btn--icon-position-right btn--withoutPopup btn--style-icon-label btn--round btn--withoutPopup">
                                                                                <span class="btn__content"><span class="btn__icon"><t t-out="icon('plus')"/></span></span>
                                                                            </a>
                                                                        </div>
                                                                        <a t-att-aria-label="entity.type === 'collection' ? t('general:showAllLabel', {label: entity.label}) : t('general:editLabel', {label: entity.label})"
                                                                           t-att-title="entity.type === 'collection' ? t('general:showAllLabel', {label: entity.label}) : t('general:editLabel', {label: entity.label})"
                                                                           t-att-href="entity.href"
                                                                           class="btn card__click btn--icon-style-without-border btn--size-medium btn--withoutPopup btn--style-none btn--withoutPopup">
                                                                            <span class="btn__content"/>
                                                                        </a>
                                                                    </div>
                                                                </li>
                                                            </t>
                                                        </ul>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
