<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payload admin (payload_cms) opened from the "Palais de Lomé" app -->
    <record id="action_palais_lome_admin" model="ir.actions.client">
        <field name="name">Palais de Lomé</field>
        <field name="tag">payload_cms.admin</field>
    </record>

    <!-- Root menu: shown in the apps menu (top left) -->
    <menuitem id="menu_palais_lome_root"
              name="Palais de Lomé"
              action="action_palais_lome_admin"
              web_icon="palais_lome,static/description/icon.png"
              groups="payload_cms.group_payload_cms_user"
              sequence="10"/>

    <!-- Sub menus (top bar of the app) -->
    <record id="action_palais_lome_ateliers" model="ir.actions.client">
        <field name="name">Ateliers</field>
        <field name="tag">payload_cms.admin</field>
        <field name="params" eval="{'path': '/collections/ateliers'}"/>
    </record>

    <menuitem id="menu_palais_lome_dashboard"
              name="Tableau de bord"
              parent="menu_palais_lome_root"
              action="action_palais_lome_admin"
              sequence="1"/>

    <menuitem id="menu_palais_lome_ateliers"
              name="Ateliers"
              parent="menu_palais_lome_root"
              action="action_palais_lome_ateliers"
              sequence="10"/>

    <!-- Configuration (actions provided by payload_cms) -->
    <menuitem id="menu_palais_lome_config"
              name="Configuration"
              parent="menu_palais_lome_root"
              sequence="90"
              groups="payload_cms.group_payload_cms_admin"/>
    <menuitem id="menu_palais_lome_config_collections" name="Collections" parent="menu_palais_lome_config"
              action="payload_cms.action_payload_config_collections" sequence="10"/>
    <menuitem id="menu_palais_lome_config_globals" name="Globals" parent="menu_palais_lome_config"
              action="payload_cms.action_payload_config_globals" sequence="20"/>
    <menuitem id="menu_palais_lome_config_fields" name="Fields" parent="menu_palais_lome_config"
              action="payload_cms.action_payload_config_fields" sequence="30"/>
    <menuitem id="menu_palais_lome_config_localization" name="Localization" parent="menu_palais_lome_config"
              action="payload_cms.action_payload_config_localization" sequence="40"/>
    <menuitem id="menu_palais_lome_config_multisite" name="Multisite" parent="menu_palais_lome_config"
              action="payload_cms.action_payload_config_multitenancy" sequence="50"/>
    <menuitem id="menu_palais_lome_config_api_docs" name="API Docs" parent="menu_palais_lome_config"
              action="payload_cms.action_payload_config_api_docs" sequence="60"/>
</odoo>
